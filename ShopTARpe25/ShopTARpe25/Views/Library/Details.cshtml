@model ShopTARpe25.Models.Library.BookDetailsViewModel

@{
	ViewData["Title"] = "Book Details";
}

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white py-3">
            <h3 class="mb-0">Book Information</h3>
        </div>
        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-4 text-muted">Title:</dt>
                <dd class="col-sm-8 fw-bold text-primary fs-5">@Model.Title</dd>

                <dt class="col-sm-4 text-muted">Author:</dt>
                <dd class="col-sm-8">@Model.Author</dd>

                <dt class="col-sm-4 text-muted">Published Year:</dt>
                <dd class="col-sm-8">@Model.PublishedYear.ToString("yyyy")</dd>

                <dt class="col-sm-4 text-muted">Status:</dt>
                <dd class="col-sm-8">
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success">Available on Shelf</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Checked Out</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <!-- Loan details card only renders if the book is not available -->
    @if (!Model.IsAvailable)
    {
        <div class="card border-danger shadow-sm mb-4">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">⚠️ Active Loan Details</h5>
            </div>
            <div class="card-body bg-light">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Borrowed By:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.ReaderFullName</dd>

                    <dt class="col-sm-4 text-muted">Loan Date:</dt>
                    <dd class="col-sm-8">@Model.LoanDate?.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Expected Return:</dt>
                    <dd class="col-sm-8 text-danger fw-bold">@Model.ReturnDate?.ToString("dd.MM.yyyy")</dd>
                </dl>
            </div>
        </div>
    }

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit Details</a>
    </div>
</div>