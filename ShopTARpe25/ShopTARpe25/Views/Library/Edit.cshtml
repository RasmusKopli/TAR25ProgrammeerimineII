@model ShopTARpe25.Models.Library.BookEditViewModel

@{
    ViewData["Title"] = "Edit Book";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="mb-0 fw-bold">Edit Book & Loan Status</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Book Title</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label fw-bold">Author</label>
                    <input asp-for="Author" class="form-control" />
                    <span asp-validation-for="Author" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PublishedYear" class="form-label fw-bold">Publication Date</label>
                    <input asp-for="PublishedYear" class="form-control" type="date" />
                    <span asp-validation-for="PublishedYear" class="text-danger small"></span>
                </div>

                <!-- NEW DROPDOWN MENÜÜ: Kui valitakse lugeja, muutub raamat laenutatuks -->
                <div class="mb-4">
                    <label asp-for="SelectedReaderId" class="form-label fw-bold">Current Loan Allocation</label>
                    <select asp-for="SelectedReaderId" asp-items="Model.ReadersList" class="form-select">
                        <option value="">-- Available (On Shelf) --</option>
                    </select>
                    <span asp-validation-for="SelectedReaderId" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Update Entry</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}