@model IEnumerable<ShopTARpe25.Models.Library.BookIndexViewModel>

@{
	ViewData["Title"] = "Library";
}

<h1>Library</h1>

<div class="mb-3">
	<a asp-action="Create" class="btn btn-primary">Create New Book</a>
</div>

<table class="table">
	<thead>
		<tr>
			<th>Title</th>
			<th>Author</th>
			<th>Published Year</th>
			<th>Availability</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var book in Model)
		{
			<tr>
				<td>@book.Title</td>
				<td>@book.Author</td>
				<td>@book.PublishedYear</td>
				<td>
					@if (book.IsAvailable)
					{
						<span class="text-success">Available</span>
					}
					else
					{
						<span class="text-danger">Checked Out</span>
					}
				</td>
				<td>
					<a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">Edit</a>
					<a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info text-white">Details</a>
					<a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>