@model IEnumerable<ShopTARpe25.Models.Library.BookIndexViewModel>

@{
	ViewData["Title"] = "Library";
}

<h1>Library</h1>

<div class="mb-3">
	<a asp-action="Create" class="btn btn-primary">Create New Book</a>
	<a asp-controller="Readers" asp-action="Index" class="btn btn-secondary">Manage Readers</a>
	<a asp-controller="Loans" asp-action="Index" class="btn btn-secondary">View Loans</a>
</div>

<div class="card bg-light p-3 mb-4">
	<form asp-action="Index" method="get" class="row g-3 align-items-center">
		<div class="col-md-5">
			<label class="form-label fw-bold small text-muted">Search by Book Title</label>
			<input type="text" name="searchTitle" class="form-control" placeholder="Enter title keywords..." value="@Context.Request.Query["searchTitle"]" />
		</div>

		<div class="col-md-3">
			<label class="form-label fw-bold small text-muted">Filter by Year</label>
			<input type="number" name="searchYear" class="form-control" placeholder="e.g. 2000" min="1000" max="2100" value="@Context.Request.Query["searchYear"]" />
		</div>

		<div class="col-md-4 d-flex align-items-end gap-2" style="padding-top: 30px;">
			<button type="submit" class="btn btn-primary px-4">Filter Catalog</button>
			<a asp-action="Index" class="btn btn-outline-secondary">Clear Filters</a>
		</div>
	</form>
</div>

<table class="table">
	<thead>
		<tr>
			<th>Title</th>
			<th>Author</th>
			<th>Published Year</th>
			<th>Availability</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var book in Model)
		{
			<tr>
				<td>@book.Title</td>
				<td>@book.Author</td>
				<td>@book.PublishedYear</td>
				<td>
					@if (book.IsAvailable)
					{
						<span class="text-success">Available</span>
					}
					else
					{
						<span class="text-danger">Checked Out</span>
					}
				</td>
				<td>
					<a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">Edit</a>
					<a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info text-white">Details</a>
					<a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>