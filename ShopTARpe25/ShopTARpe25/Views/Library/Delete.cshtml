@model ShopTARpe25.Models.Library.BookEditViewModel

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0 fw-bold">Delete Book Confirmation</h4>
        </div>
        <div class="card-body p-4">
            <h5 class="text-danger mb-4">Are you sure you want to delete this book?</h5>
            
            <dl class="row bg-light p-3 rounded border mb-4">
                <dt class="col-sm-4 text-muted">Book Title:</dt>
                <dd class="col-sm-8 fw-bold">@Model.Title</dd>

                <dt class="col-sm-4 text-muted">Author:</dt>
                <dd class="col-sm-8">@Model.Author</dd>

                <dt class="col-sm-4 text-muted">Published:</dt>
                <dd class="col-sm-8">@Model.PublishedYear.ToString("yyyy")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <!-- Hidden input field ensuring the correct record Guid drops -->
                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-between pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel and Go Back</a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold">Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

