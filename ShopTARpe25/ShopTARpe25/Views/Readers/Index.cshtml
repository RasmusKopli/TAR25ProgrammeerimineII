@model IEnumerable<ShopTARpe25.Models.Library.ReaderIndexViewModel>

@{
    ViewData["Title"] = "Reader Registry";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Registered Readers Index</h2>
        <a asp-controller="Library" asp-action="Index" class="btn btn-outline-primary">Back to Book Index</a>
    </div>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Contact Email</th>
                <th>Books Checked Out</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-3">No readers currently cataloged.</td>
                </tr>
            }
            else
            {
                @foreach (var reader in Model)
                {
                    <tr>
                        <td class="fw-bold">@reader.FullName</td>
                        <td>@reader.Email</td>
                        <td>
                            @if (reader.ActiveLoansCount > 0)
                            {
                                <span class="badge bg-danger">@reader.ActiveLoansCount Books</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Clear</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" disabled>Edit Profile</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
