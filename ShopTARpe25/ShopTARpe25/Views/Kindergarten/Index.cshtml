@model IEnumerable<ShopTARpe25.Models.Kindergarten.KindergartenIndexViewModel>

@{
	int rownumber = 1;
}

<div class="row">
	<div class="col-md-12">
		<h2>Kindergarten</h2>
	</div>
</div>

<div class="mb-3">
	<a asp-action="Create" class="btn btn-primary">Create New Kindergarten Entry</a>
</div>

<form method="get">
	<table class="table table-hover">
		<thead>
			<tr>
				<th scope="col">Nr</th>
				<th scope="col">Group Name</th>
				<th scope="col">Children Count</th>
				<th scope="col">Kindergarten Name</th>
				<th scope="col">Teacher Name</th>
				<th scope="col">Created At</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var kindergarten in Model)
			{
				<tr>
					<td>@rownumber</td>
					<td>@kindergarten.GroupName</td>
					<td>@kindergarten.ChildrenCount</td>
					<td>@kindergarten.KindergartenName</td>
					<td>@kindergarten.TeacherName</td>
					<td>@kindergarten.CreatedAt.ToString("yyyy-MM-dd")</td>
					<td>
						<a asp-action="Details" asp-route-id="@kindergarten.Id" class="btn btn-info">Details</a>
						<a asp-action="Update" asp-route-id="@kindergarten.Id" class="btn btn-warning">Update</a>
						<a asp-action="Delete" asp-route-id="@kindergarten.Id" class="btn btn-danger">Delete</a>
					</td>
				</tr>
					rownumber++;
			}
		</tbody>
	</table>
</form>