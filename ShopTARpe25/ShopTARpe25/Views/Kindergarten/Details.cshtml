@model ShopTARpe25.Models.Kindergarten.KindergartenDetailsViewModel

@{
    ViewData["Title"] = "Kindergarten Details";
}

<div class="container mt-4">
    <h2>Kindergarten Record Details</h2>
    <hr />

    <div class="card shadow-sm col-md-8 m-auto">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">@Model.KindergartenName</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4 font-weight-bold">Database ID:</dt>
                <dd class="col-sm-8 text-muted">@Model.Id</dd>

                <dt class="col-sm-4 font-weight-bold">Group Name:</dt>
                <dd class="col-sm-8">@Model.GroupName</dd>

                <dt class="col-sm-4 font-weight-bold">Children Count:</dt>
                <dd class="col-sm-8">@Model.ChildrenCount</dd>

                <dt class="col-sm-4 font-weight-bold">Teacher Name:</dt>
                <dd class="col-sm-8">@Model.TeacherName</dd>

                <dt class="col-sm-4 font-weight-bold">Created At:</dt>
                <dd class="col-sm-8 text-muted">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>

                <dt class="col-sm-4 font-weight-bold">Last Modified At:</dt>
                <dd class="col-sm-8 text-muted">@Model.ModifiedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            </dl>
        </div>
        <div class="card-footer bg-light d-flex justify-content-end">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>